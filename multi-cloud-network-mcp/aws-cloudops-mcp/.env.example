# Copy this file to .env and adjust values for local development.
# Do NOT commit a real .env file or real AWS credentials.

APP_NAME=aws-cloudops-mcp
LOG_LEVEL=INFO

# Leave blank to use the default boto3 credential resolution chain
# (environment variables, ~/.aws/credentials, ~/.aws/config, SSO, or an
# instance/task IAM role when running inside AWS).
AWS_PROFILE=
AWS_DEFAULT_REGION=us-east-1

# Optional cross-account access. If AWS_ROLE_ARN is set, the server will
# call sts:AssumeRole using the base credentials above to obtain temporary
# credentials scoped to the target account/role.
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
AWS_SESSION_NAME=aws-cloudops-mcp

# boto3/botocore client tuning
AWS_MAX_ATTEMPTS=3
AWS_CONNECT_TIMEOUT=5
AWS_READ_TIMEOUT=20

# Safety limit applied to paginated AWS API results per tool call
MAX_PAGE_RESULTS=1000
