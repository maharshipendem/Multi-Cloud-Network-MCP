# Copy this file to .env and adjust values for local development.
# Do NOT commit a real .env file. Every value below is a non-secret
# identifier -- this file must never contain a client secret, certificate,
# or any other credential material. See docs/security.md#credential-handling.

APP_NAME=azure-network-mcp
LOG_LEVEL=INFO

# Non-secret identity scoping for DefaultAzureCredential. Leave both blank
# to use DefaultAzureCredential's standard resolution chain unscoped
# (environment variables for a service principal, workload identity
# federation, a managed identity, or an `az login` session).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Optional allowlists (comma-separated IDs). When set, a tool call naming a
# subscription/tenant outside the list is rejected before any Azure API
# call is made. Leave blank to allow whatever the configured identity's
# RBAC role can see.
AZURE_SUBSCRIPTION_ALLOWLIST=
AZURE_TENANT_ALLOWLIST=

# Subscription used when a tool call doesn't specify one explicitly.
AZURE_DEFAULT_SUBSCRIPTION_ID=

# ARM SDK client tuning
AZURE_MAX_RETRIES=3
AZURE_CONNECTION_TIMEOUT=5.0
AZURE_READ_TIMEOUT=20.0

# Safety limits
MAX_PAGE_RESULTS=1000
MAX_FANOUT_CALLS=50
MAX_CONCURRENCY=10
