# Copy this file to .env and adjust values for local development.
# Do NOT commit a real .env file. Every value below is a non-secret
# identifier -- this file must never contain a service account key file's
# contents, an access token, or any other credential material. See
# docs/security.md#credential-handling.

APP_NAME=gcp-network-mcp
LOG_LEVEL=INFO

# Non-secret quota/billing project and impersonation target for
# Application Default Credentials. Leave both blank to use ADC's standard
# resolution chain unscoped (a user's `gcloud auth application-default
# login` session, an attached service account, or workload identity
# federation).
GCP_QUOTA_PROJECT_ID=
GCP_IMPERSONATE_SERVICE_ACCOUNT=

# Optional allowlists (comma-separated IDs). When set, a tool call naming
# a project/folder/organization outside the list is rejected before any
# GCP API call is made. Leave blank to allow whatever the configured
# identity's IAM bindings can see.
GCP_PROJECT_ALLOWLIST=
GCP_FOLDER_ALLOWLIST=
GCP_ORGANIZATION_ALLOWLIST=

# Project used when a tool call doesn't specify one explicitly.
GCP_DEFAULT_PROJECT_ID=

# GCP client library tuning
GCP_MAX_RETRIES=3
GCP_TIMEOUT_SECONDS=20.0

# Safety limits
MAX_PAGE_RESULTS=1000
MAX_FANOUT_CALLS=50
MAX_CONCURRENCY=10
